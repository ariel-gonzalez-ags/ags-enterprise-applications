# syntax=docker/dockerfile:1
# AWS variant: base toolchain + the AWS CLI v2 (official installer, pinned).
# Thin layer over the shared base; a host reuses base and pulls only this.
ARG BASE_IMAGE=ghcr.io/ariel-gonzalez-ags/ags-sandbox-base:latest
FROM ${BASE_IMAGE}

USER root
ARG AWS_CLI_VERSION=2.36.49
RUN curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-x86_64-${AWS_CLI_VERSION}.zip" \
        -o /tmp/awscliv2.zip \
    && unzip -q /tmp/awscliv2.zip -d /tmp \
    && /tmp/aws/install \
    && rm -rf /tmp/aws /tmp/awscliv2.zip
USER sandbox
