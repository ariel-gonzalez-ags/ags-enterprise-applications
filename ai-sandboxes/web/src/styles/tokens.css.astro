---
// P6 "deep magma" design tokens. Import once in Base.astro; never hardcode
// these values elsewhere — always reference var(--token-name).
---
<style is:global>
  :root {
    /* Elevation scale — 4 clearly separated shades, neutral graphite:
       bg (page) < panel (rails) < panel2 (cards/bubbles) < raised (hover/active).
       Surfaces carry no orange cast — ember only appears as --accent. */
    --bg: #08080A;
    --panel: #101013;
    --panel2: #17171C;
    --raised: #202027;
    --line: #232329;
    --line2: #33333C;
    --text: #F0EFEC;
    --muted: #9D9DA8;
    --muted2: #6A6A76;
    --accent: #F05623;          /* magma ember — signal only, never decoration */
    --accent-dim: rgba(240, 86, 35, .12);
    --warn: #FFB184;
    --red: #E5484D;
    --deep-red: #A82405;        /* secondary, brand only */
    --radius: 14px;
    --shadow: rgba(0, 0, 0, .5);
    --on-accent: #160802;   /* text on solid ember */
    --scrim: rgba(8, 8, 10, .88);
    --scrim-nav: rgba(8, 8, 10, .72);
    color-scheme: dark;
  }

  [data-theme='light'] {
    /* Light "paper" theme — neutral warm-gray inversion of the dark scale. */
    --bg: #F3F3F4;
    --panel: #FFFFFF;
    --panel2: #F8F8F9;
    --raised: #EDEDEF;
    --line: #E4E4E7;
    --line2: #D2D2D8;
    --text: #1D1D22;
    --muted: #5F5F6A;
    --muted2: #8E8E99;
    --accent: #D8440F;          /* slightly deeper for contrast on light */
    --accent-dim: rgba(216, 68, 15, .10);
    --warn: #B45A1B;
    --shadow: rgba(29, 29, 34, .15);
    --on-accent: #FFFFFF;
    --scrim: rgba(243, 243, 244, .9);
    --scrim-nav: rgba(243, 243, 244, .8);
    color-scheme: light;
  }
  * { box-sizing: border-box; margin: 0; padding: 0 }
  html { scroll-behavior: smooth }
  body {
    background: var(--bg);
    color: var(--text);
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    font-size: 16px; line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
  }
  ::selection { background: var(--accent); color: #FFFFFF }

  /* Scrollbars — thin, token-keyed, unobtrusive */
  * { scrollbar-width: thin; scrollbar-color: var(--line2) transparent }
  *::-webkit-scrollbar { width: 9px; height: 9px }
  *::-webkit-scrollbar-track { background: transparent }
  *::-webkit-scrollbar-thumb {
    background: var(--line2); border-radius: 99px;
    border: 2px solid var(--bg); /* padding illusion so thumbs float */
  }
  *::-webkit-scrollbar-thumb:hover { background: var(--muted2) }
  *::-webkit-scrollbar-corner { background: transparent }
  .mono { font-family: 'JetBrains Mono', monospace }
  a { color: inherit; text-decoration: none }
</style>
