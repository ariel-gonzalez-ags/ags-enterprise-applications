---
// P6 "deep magma" design tokens. Import once in Base.astro; never hardcode
// these values elsewhere — always reference var(--token-name).
---
<style is:global>
  :root {
    /* Elevation scale — 4 clearly separated dark shades, deepest at the bottom:
       bg (page) < panel (rails) < panel2 (cards/bubbles) < raised (hover/active) */
    --bg: #070605;
    --panel: #0F0D0A;
    --panel2: #191512;
    --raised: #231D17;
    --line: #211B14;
    --line2: #322821;
    --text: #F2EDE8;
    --muted: #A09385;
    --muted2: #6E6257;
    --accent: #F05623;          /* magma ember — signal only, never decoration */
    --accent-dim: rgba(240, 86, 35, .12);
    --warn: #FFB184;
    --red: #E5484D;
    --deep-red: #A82405;        /* secondary, brand only */
    --radius: 14px;
  }
  * { box-sizing: border-box; margin: 0; padding: 0 }
  html { scroll-behavior: smooth }
  body {
    background: var(--bg);
    color: var(--text);
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    font-size: 16px; line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
  }
  ::selection { background: var(--accent); color: #160802 }
  .mono { font-family: 'JetBrains Mono', monospace }
  a { color: inherit; text-decoration: none }
</style>
