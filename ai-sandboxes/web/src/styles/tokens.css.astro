---
// P6 "deep magma" design tokens. Import once in Base.astro; never hardcode
// these values elsewhere — always reference var(--token-name).
---
<style is:global>
  :root {
    /* Elevation scale — 4 clearly separated dark shades, deepest at the bottom:
       bg (page) < panel (rails) < panel2 (cards/bubbles) < raised (hover/active) */
    --bg: #070605;
    --panel: #0F0D0A;
    --panel2: #191512;
    --raised: #231D17;
    --line: #211B14;
    --line2: #322821;
    --text: #F2EDE8;
    --muted: #A09385;
    --muted2: #6E6257;
    --accent: #F05623;          /* magma ember — signal only, never decoration */
    --accent-dim: rgba(240, 86, 35, .12);
    --warn: #FFB184;
    --red: #E5484D;
    --deep-red: #A82405;        /* secondary, brand only */
    --radius: 14px;
    --shadow: rgba(0, 0, 0, .5);
    --on-accent: #160802;   /* text on solid ember */
    --scrim: rgba(6, 5, 4, .88);
    --scrim-nav: rgba(6, 5, 4, .72);
    color-scheme: dark;
  }

  [data-theme='light'] {
    /* Light "ash" theme — same warm hue family, inverted elevation:
       paper bg, white-ish panels, warm gray lines. Accent stays ember. */
    --bg: #F4F1ED;
    --panel: #FFFFFF;
    --panel2: #FAF7F4;
    --raised: #EFE9E3;
    --line: #E7E0D9;
    --line2: #D5CCC2;
    --text: #231D17;
    --muted: #6E6257;
    --muted2: #9A8C7F;
    --accent: #D8440F;          /* slightly deeper for contrast on light */
    --accent-dim: rgba(216, 68, 15, .10);
    --warn: #B45A1B;
    --shadow: rgba(35, 29, 23, .18);
    --on-accent: #FFFFFF;
    --scrim: rgba(244, 241, 237, .9);
    --scrim-nav: rgba(244, 241, 237, .8);
    color-scheme: light;
  }
  * { box-sizing: border-box; margin: 0; padding: 0 }
  html { scroll-behavior: smooth }
  body {
    background: var(--bg);
    color: var(--text);
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    font-size: 16px; line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
  }
  ::selection { background: var(--accent); color: #FFFFFF }

  /* Scrollbars — thin, token-keyed, unobtrusive */
  * { scrollbar-width: thin; scrollbar-color: var(--line2) transparent }
  *::-webkit-scrollbar { width: 9px; height: 9px }
  *::-webkit-scrollbar-track { background: transparent }
  *::-webkit-scrollbar-thumb {
    background: var(--line2); border-radius: 99px;
    border: 2px solid var(--bg); /* padding illusion so thumbs float */
  }
  *::-webkit-scrollbar-thumb:hover { background: var(--muted2) }
  *::-webkit-scrollbar-corner { background: transparent }
  .mono { font-family: 'JetBrains Mono', monospace }
  a { color: inherit; text-decoration: none }
</style>
