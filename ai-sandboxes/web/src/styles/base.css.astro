---
// Generic primitives shared across pages. Import where needed.
---
<style is:global>
  /* The [hidden] attribute must always win over any class that sets `display`
     (flex/grid/block), or a hidden panel still shows. This one global rule is
     the permanent fix; without it, e.g. a card gate with display:flex stayed
     visible after it should have hidden. */
  [hidden] { display: none !important }

  .wrap { max-width: 1200px; margin: 0 auto; padding: 0 32px }

  .btn {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 9px 18px; border-radius: 10px; font-size: 14px; font-weight: 500;
    border: 1px solid var(--line2); background: var(--panel); color: var(--text);
    cursor: pointer; transition: .2s;
  }
  .btn:hover { border-color: #57301A; background: var(--panel2) }
  .btn.primary {
    position: relative; border-color: transparent; font-weight: 600; color: var(--on-accent);
    background: linear-gradient(160deg, #FF7038 0%, var(--accent) 46%, #D63F0E 100%);
    box-shadow: 0 8px 24px rgba(240, 86, 35, .32), inset 0 1px 0 rgba(255, 255, 255, .22);
    transition: transform .18s ease, box-shadow .18s ease, filter .18s ease;
  }
  .btn.primary:hover {
    filter: brightness(1.06); transform: translateY(-1px);
    box-shadow: 0 12px 32px rgba(240, 86, 35, .42), inset 0 1px 0 rgba(255, 255, 255, .28);
  }
  .btn.primary:active { transform: translateY(0); filter: brightness(.98) }
  .btn.ghost { background: transparent; border-color: transparent; color: var(--muted) }
  .btn.ghost:hover { color: var(--text) }
  .btn.lg { padding: 13px 26px; font-size: 15px; border-radius: 12px }

  /* Standard section scaffolding */
  section { padding: 96px 0 }
  .sec-head { max-width: 680px; margin-bottom: 56px }
  .sec-eyebrow {
    font-size: 13px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase;
    color: var(--accent); margin-bottom: 14px; font-family: 'JetBrains Mono', monospace;
  }
  .sec-title { font-size: clamp(28px, 4vw, 42px); font-weight: 600; letter-spacing: -.025em; line-height: 1.15; margin-bottom: 16px }
  .sec-desc { color: var(--muted); font-size: 17px }

  @media (max-width: 900px) {
    .nav-links { display: none }
  }
</style>
