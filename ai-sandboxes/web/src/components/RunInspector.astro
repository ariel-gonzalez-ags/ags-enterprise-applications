---
// Right inspector: run guarantees and artifacts. Shell only: console.js
// reflects the selected task's config + artifacts. The target-cloud picker
// lives in the left rail (TaskRail) next to New task.
import Icon from './Icon.astro';
---
<div class="insp">
  <section>
    <h3><Icon name="sliders" size={14} /> Guarantees</h3>
    <div class="guarantee">
      <div>
        <div class="g-title"><Icon name="repeat" size={14} /> Idempotent result</div>
        <div class="g-desc">Re-running the deliverable converges to the same state. No drift, no double-apply.</div>
      </div>
      <span class="toggle" data-console="idempotent"><span class="knob"></span></span>
    </div>
    <div class="guarantee">
      <div>
        <div class="g-title"><Icon name="shield" size={14} /> Destroy sandbox after handover</div>
        <div class="g-desc">Credentials and resources are torn down; only artifacts and evidence persist.</div>
      </div>
      <span class="toggle" data-console="destroy-after"><span class="knob"></span></span>
    </div>
    <div class="guarantee">
      <div>
        <div class="g-title"><Icon name="clock" size={14} /> Max sandbox time</div>
        <div class="g-desc">Hard stop. The sandbox burns down even if the task is mid-flight.</div>
      </div>
      <span class="mono budget" data-console="max-hours">—</span>
    </div>
  </section>

  <section>
    <h3><Icon name="folder" size={14} /> Artifacts</h3>
    <div class="art-list" data-console="artifacts">
      <p class="hint">No artifacts yet. They appear when a run verifies.</p>
    </div>
    <p class="hint foot">Delivered runs keep artifacts + evidence forever; the sandbox itself is gone.</p>
  </section>
</div>

<div class="art-viewer" data-console="artifact-viewer" hidden>
  <div class="art-modal">
    <div class="art-modal-head">
      <span class="mono" data-console="artifact-name"></span>
      <span class="art-modal-actions">
        <a class="art-dl" data-console="artifact-download" href="#" download>
          <Icon name="download" size={13} /> download
        </a>
        <button class="art-close" data-console="artifact-close" type="button" aria-label="Close">
          <Icon name="x" size={14} />
        </button>
      </span>
    </div>
    <pre class="art-body mono" data-console="artifact-body"></pre>
  </div>
</div>

<style>
  .insp { padding: 22px 18px; display: flex; flex-direction: column; gap: 28px }
  .insp section { padding: 0 } /* cancel the marketing base.css section scaffold */
  section h3 {
    font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: .06em;
    color: var(--muted); display: flex; align-items: center; gap: 7px; margin-bottom: 8px;
  }
  .hint { font-size: 12px; color: var(--muted2); line-height: 1.5; margin-bottom: 12px }
  .hint.foot { margin: 12px 0 0 }

  .fmt-kind { font-size: 9.5px; color: var(--muted2); text-transform: uppercase; letter-spacing: .05em }

  .guarantee { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; padding: 10px 0; border-bottom: 1px dashed var(--line2) }
  .guarantee:last-child { border-bottom: none }
  .g-title { font-size: 13px; font-weight: 500; display: flex; align-items: center; gap: 7px; margin-bottom: 3px }
  .g-title svg { color: var(--muted) }
  .g-desc { font-size: 11.5px; color: var(--muted2); line-height: 1.5 }
  .budget { font-size: 13px; color: var(--accent); padding-top: 2px }

  .toggle { width: 34px; height: 20px; border-radius: 99px; background: var(--line2); position: relative; flex-shrink: 0; cursor: pointer; transition: .2s }
  .toggle .knob { position: absolute; top: 3px; left: 3px; width: 14px; height: 14px; border-radius: 50%; background: var(--muted); transition: .2s }
  .toggle.on { background: var(--accent) }
  .toggle.on .knob { left: 17px; background: var(--on-accent) }

  .art-list { display: flex; flex-direction: column; gap: 8px }
  /* Artifact cards render at runtime via console.js: global under .art-list */
  .art-list :global(.art) { background: var(--panel2); border: 1px solid var(--line); border-radius: 10px; padding: 10px 12px; text-align: left; width: 100%; font: inherit; color: inherit; cursor: pointer; transition: .15s }
  .art-list :global(.art:hover) { border-color: var(--accent) }
  .art-list :global(.art-top) { display: flex; justify-content: space-between; align-items: center; margin-bottom: 3px }
  .art-list :global(.art-name) { font-size: 12px; color: var(--text) }
  .art-list :global(.art-size) { font-size: 10.5px; color: var(--muted2) }
  .art-list :global(.art-note) { font-size: 11.5px; color: var(--muted2) }

  .art-viewer {
    position: fixed; inset: 0; background: rgba(0,0,0,.6); z-index: 60;
    display: grid; place-items: center; padding: 24px;
  }
  .art-viewer[hidden] { display: none }
  .art-modal {
    background: var(--panel); border: 1px solid var(--line2); border-radius: 14px;
    width: min(760px, 100%); max-height: 80vh; display: flex; flex-direction: column; overflow: hidden;
  }
  .art-modal-head {
    display: flex; justify-content: space-between; align-items: center; gap: 12px;
    padding: 14px 16px; border-bottom: 1px solid var(--line);
  }
  .art-modal-head .mono { font-size: 13px; color: var(--text) }
  .art-modal-actions { display: inline-flex; align-items: center; gap: 10px }
  .art-dl {
    display: inline-flex; align-items: center; gap: 6px; font-size: 12px; font-weight: 500;
    color: var(--accent); text-decoration: none; padding: 5px 10px; border: 1px solid var(--line2);
    border-radius: 8px; transition: .15s;
  }
  .art-dl:hover { border-color: var(--accent) }
  .art-close {
    display: grid; place-items: center; width: 28px; height: 28px; border-radius: 8px;
    background: transparent; border: 1px solid var(--line2); color: var(--muted); cursor: pointer; transition: .15s;
  }
  .art-close:hover { color: var(--text); border-color: var(--line2); background: var(--raised) }
  .art-body {
    margin: 0; padding: 16px; overflow: auto; font-size: 12px; line-height: 1.6;
    color: var(--muted); white-space: pre-wrap; word-break: break-word;
  }
</style>
