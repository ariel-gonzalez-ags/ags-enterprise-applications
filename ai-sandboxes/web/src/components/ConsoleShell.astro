---
// Console shell: fixed nav + three-pane grid (library / stage / inspector).
// Height fills the viewport below the nav; panes scroll independently.
// Anonymous users get redirected to /login by the gate script in app.astro;
// the #gate overlay below is only a no-JS / script-failure fallback.
// Single-pane pages (e.g. /usage) pass only the stage slot and get a centered
// single column instead of the three-pane console grid.
interface Props {
  title?: string;
}
const { title = 'Agisphire: Console' } = Astro.props;
const single = !Astro.slots.has('rail') && !Astro.slots.has('inspector');
import Base from '../layouts/Base.astro';
import ConsoleNav from './ConsoleNav.astro';
import Logo from './Logo.astro';
---
<Base title={title} auth>
  <ConsoleNav />
  {single ? (
    <div class="console single">
      <main class="pane stage"><slot name="stage" /></main>
    </div>
  ) : (
    <div class="console">
      <aside class="pane rail"><slot name="rail" /></aside>
      <main class="pane stage"><slot name="stage" /></main>
      <aside class="pane inspector"><slot name="inspector" /></aside>
    </div>
  )}

  <div id="gate" hidden class="gate-overlay">
    <div class="gate-card">
      <div class="gate-logo"><Logo size={44} /></div>
      <p class="gate-eyebrow mono">Agisphire console</p>
      <h1>Sign in to continue</h1>
      <a href="/login" class="btn primary lg">Go to sign in</a>
    </div>
  </div>
</Base>

<style>
  .console {
    display: grid;
    grid-template-columns: 300px 1fr 320px;
    height: 100vh;
    padding-top: 56px; /* console nav height */
  }
  .pane { overflow-y: auto; min-height: 0 }
  .rail { border-right: 1px solid var(--line); background: var(--panel) }
  .inspector { border-left: 1px solid var(--line); background: var(--panel) }
  .stage { display: flex; flex-direction: column }
  .console.single { display: block; max-width: 860px; margin: 0 auto }
  .console.single .stage { padding: 32px 24px 64px }

  .gate-overlay {
    position: fixed; inset: 0; z-index: 60; display: grid; place-items: center;
    background: var(--scrim); backdrop-filter: blur(10px); padding: 24px;
  }
  .gate-overlay[hidden] { display: none }
  .gate-card {
    text-align: center; padding: 52px 56px; max-width: 460px;
    background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius);
  }
  .gate-logo { display: flex; justify-content: center; margin-bottom: 18px }
  .gate-eyebrow { font-size: 11px; color: var(--accent); text-transform: uppercase; letter-spacing: .08em; margin-bottom: 12px }
  .gate-card h1 { font-size: 24px; font-weight: 600; letter-spacing: -.02em; margin-bottom: 22px; line-height: 1.25 }

  @media (max-width: 1100px) {
    .console { grid-template-columns: 1fr; height: auto }
    .rail, .inspector { border: none; border-bottom: 1px solid var(--line) }
    .gate-card { padding: 40px 28px }
  }
</style>
