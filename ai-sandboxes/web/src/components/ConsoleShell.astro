---
// Console shell: fixed nav + three-pane grid (library / stage / inspector).
// Height fills the viewport below the nav; panes scroll independently.
// Includes the anonymous-user gate overlay (toggled by the page's script).
interface Props {
  title?: string;
}
const { title = 'Agisphire — Console' } = Astro.props;
import Base from '../layouts/Base.astro';
import Nav from './Nav.astro';
---
<Base title={title} auth>
  <Nav />
  <div class="console">
    <aside class="pane rail"><slot name="rail" /></aside>
    <main class="pane stage"><slot name="stage" /></main>
    <aside class="pane inspector"><slot name="inspector" /></aside>
  </div>

  <div id="gate" hidden class="gate-overlay">
    <div class="gate-card">
      <h1>Your sandbox console</h1>
      <p>This area requires an account.</p>
      <a href="/api/auth/login?next=/app" class="btn primary lg">Sign in with Google</a>
    </div>
  </div>
</Base>

<style>
  .console {
    display: grid;
    grid-template-columns: 300px 1fr 320px;
    height: 100vh;
    padding-top: 80px; /* nav height */
  }
  .pane { overflow-y: auto; min-height: 0 }
  .rail { border-right: 1px solid var(--line); background: var(--panel) }
  .inspector { border-left: 1px solid var(--line); background: var(--panel) }
  .stage { display: flex; flex-direction: column }

  .gate-overlay {
    position: fixed; inset: 0; z-index: 60; display: grid; place-items: center;
    background: rgba(6, 5, 4, .88); backdrop-filter: blur(8px);
  }
  .gate-overlay[hidden] { display: none }
  .gate-card {
    text-align: center; padding: 48px 56px;
    background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius);
  }
  .gate-card h1 { font-size: 26px; font-weight: 600; letter-spacing: -.02em; margin-bottom: 10px }
  .gate-card p { color: var(--muted); margin-bottom: 26px }

  @media (max-width: 1100px) {
    .console { grid-template-columns: 1fr; height: auto }
    .rail, .inspector { border: none; border-bottom: 1px solid var(--line) }
  }
</style>
