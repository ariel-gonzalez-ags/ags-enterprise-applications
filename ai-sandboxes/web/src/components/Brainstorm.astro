---
// Center stage: brainstorm conversation with the planner agent + composer.
// Shell only: console.js renders the thread from GET /api/tasks/{id} and
// posts to /api/tasks/{id}/messages.
import Icon from './Icon.astro';
---
<div class="run-head">
  <div>
    <div class="run-eyebrow mono" data-console="run-eyebrow">no task selected</div>
    <h1 class="run-title" data-console="run-title">Pick a task, or start a new one</h1>
  </div>
  <div class="run-actions">
    <button class="btn primary" data-console="approve" hidden>Approve plan</button>
  </div>
</div>

<div class="thread" data-console="thread">
  <p class="empty mono">Select a task from the library to see the conversation.</p>
</div>

<!-- Live sandbox activity feed: shown while a run is in progress so the user
     sees the agent working instead of a frozen thread. console.js fills it
     from the task's live run_log. -->
<div class="runfeed" data-console="runfeed" hidden>
  <div class="runfeed-head">
    <span class="runfeed-pulse"></span>
    <span class="mono" data-console="runfeed-status">sandbox running</span>
  </div>
  <div class="runfeed-body mono" data-console="runfeed-body"></div>
</div>

<div class="composer">
  <div class="composer-box">
    <textarea rows="2" data-console="input"
      placeholder="Describe the task, answer the planner, or attach context…"></textarea>
    <button class="send" data-console="send" title="Send"><Icon name="send" size={16} /></button>
  </div>
  <div class="composer-hint mono">planner agent · sandbox-scoped credentials · nothing touches production</div>
</div>

<style>
  .run-head {
    display: flex; justify-content: space-between; align-items: center; gap: 16px;
    padding: 22px 28px; border-bottom: 1px solid var(--line);
  }
  .run-eyebrow { font-size: 11.5px; color: var(--muted); margin-bottom: 6px }
  .run-eyebrow .live { color: var(--accent) }
  .run-title { font-size: 18px; font-weight: 600; letter-spacing: -.02em }
  .run-actions { display: flex; gap: 10px; flex-shrink: 0 }
  /* .btn's display rule beats the UA [hidden] style: enforce it */
  .run-actions .btn[hidden] { display: none }
  .run-actions .btn.primary { background: transparent; border: 1px solid var(--accent); color: var(--accent) }
  .run-actions .btn.primary:hover { background: var(--accent-dim); color: var(--accent) }

  .thread { flex: 1; padding: 26px 28px; display: flex; flex-direction: column; gap: 18px; overflow-y: auto }

  /* Live sandbox activity feed (visible only while a run is in progress) */
  .runfeed {
    margin: 0 28px 16px; border: 1px solid var(--line2); border-radius: 12px;
    background: var(--panel); overflow: hidden; flex-shrink: 0;
  }
  .runfeed[hidden] { display: none }
  .runfeed-head {
    display: flex; align-items: center; gap: 9px; padding: 10px 14px;
    border-bottom: 1px solid var(--line); font-size: 11px; color: var(--muted);
    text-transform: uppercase; letter-spacing: .06em;
  }
  .runfeed-pulse {
    width: 8px; height: 8px; border-radius: 50%; background: var(--accent);
    animation: runpulse 1.2s ease-in-out infinite;
  }
  @keyframes runpulse { 50% { opacity: .25; transform: scale(.8) } }
  .runfeed-body {
    padding: 12px 14px; max-height: 180px; overflow-y: auto;
    font-size: 12px; line-height: 1.6; color: var(--muted); white-space: pre-wrap;
    word-break: break-word;
  }
  .runfeed-body :global(.rf-tool) { color: var(--accent) }
  .runfeed-body :global(.rf-step) { color: var(--text) }
  /* Messages render at runtime via console.js: global selectors under
     .thread so Astro scoping doesn't drop their styles. */
  .thread :global(.empty) { font-size: 11.5px; color: var(--muted2) }
  .thread :global(.msg) { max-width: 78% }
  .thread :global(.msg.user) { align-self: flex-end }
  .thread :global(.msg.user .msg-body) {
    background: var(--panel2); border: 1px solid var(--line);
    border-radius: 14px 14px 4px 14px;
    padding: 12px 16px; font-size: 14px; line-height: 1.55;
  }
  .thread :global(.msg.agent) { align-self: flex-start }
  .thread :global(.msg-agent-tag) { display: flex; align-items: center; gap: 6px; font-size: 10.5px; color: var(--muted); margin-bottom: 6px; text-transform: uppercase; letter-spacing: .05em }
  .thread :global(.msg.agent .msg-body) {
    background: transparent; border-left: 2px solid var(--line2);
    border-radius: 0; padding: 2px 0 2px 16px;
    font-size: 14px; line-height: 1.65; color: var(--text); white-space: pre-line;
  }
  .thread :global(.msg.pending .msg-body) { color: var(--muted2); font-style: italic }

  .composer { padding: 16px 28px 20px; border-top: 1px solid var(--line) }
  .composer-box {
    display: flex; gap: 10px; align-items: flex-end;
    background: var(--panel2); border: 1px solid var(--line); border-radius: 14px;
    padding: 12px 12px 12px 16px;
  }
  .composer-box:focus-within { border-color: var(--line2) }
  textarea {
    flex: 1; background: transparent; border: none; resize: none; outline: none;
    color: var(--text); font-family: 'Inter', sans-serif; font-size: 14px; line-height: 1.5;
  }
  textarea::placeholder { color: var(--muted2) }
  .send {
    display: grid; place-items: center; width: 34px; height: 34px; border-radius: 10px;
    background: transparent; border: 1px solid var(--line2); color: var(--muted);
    cursor: pointer; flex-shrink: 0; transition: .2s;
  }
  .send:hover { border-color: var(--accent); color: var(--accent) }
  .send:disabled { opacity: .4; cursor: default }
  .composer-hint { margin-top: 10px; font-size: 10.5px; color: var(--muted2); text-align: center }

  /* Plan card: rendered by console.js when a message carries a plan */
  .thread :global(.choice-card) {
    background: var(--panel2); border: 1px solid var(--line); border-radius: 12px;
    padding: 16px; max-width: 520px; margin-top: 10px;
  }
  .thread :global(.choice-q) { font-size: 13.5px; color: var(--text); margin-bottom: 12px }
  .thread :global(.choice-opts) { display: flex; flex-direction: column; gap: 6px; margin-bottom: 14px }
  .thread :global(.choice-card .opt) {
    display: flex; align-items: center; flex-wrap: wrap; gap: 8px 11px; text-align: left;
    background: var(--raised); border: 1px solid var(--line2); border-radius: 10px;
    padding: 9px 12px; width: 100%; color: inherit; font: inherit;
  }
  .thread :global(.choice-card.editable .opt) { cursor: pointer; transition: .15s }
  .thread :global(.choice-card.editable .opt:hover) { border-color: var(--accent) }
  .thread :global(.choice-card .opt:not(.on)) { opacity: .5 }
  .thread :global(.opt-check) {
    width: 16px; height: 16px; border-radius: 5px; border: 1px solid var(--accent);
    display: grid; place-items: center; color: var(--accent); flex-shrink: 0;
  }
  .thread :global(.opt:not(.on) .opt-check) { border-color: var(--line2) }
  /* Info toggle: reveals the rationale inline. Not a checkbox control. */
  .thread :global(.opt-info) {
    margin-left: auto; width: 20px; height: 20px; border-radius: 50%; flex-shrink: 0;
    display: grid; place-items: center; color: var(--muted2); cursor: pointer;
    transition: .15s;
  }
  .thread :global(.opt-info:hover) { color: var(--accent); background: var(--panel) }
  .thread :global(.opt-info.open) { color: var(--accent) }
  /* Rationale spans full width under the chip row when revealed. */
  .thread :global(.opt-why) {
    flex-basis: 100%; font-size: 12px; color: var(--muted2); line-height: 1.5;
    padding: 2px 2px 0 27px;  /* align with the name, past the checkbox */
  }
  .thread :global(.opt-why[hidden]) { display: none }
  .thread :global(.opt-add) { display: flex; gap: 8px; margin-bottom: 14px }
  .thread :global(.opt-add input) {
    flex: 1; background: var(--panel); border: 1px dashed var(--line2); border-radius: 10px;
    padding: 9px 12px; color: var(--text); font: inherit; font-size: 12.5px; outline: none;
  }
  .thread :global(.opt-add input:focus) { border-color: var(--accent); border-style: solid }
  .thread :global(.opt-add button) {
    width: 36px; border-radius: 10px; background: transparent; border: 1px solid var(--line2);
    color: var(--muted); cursor: pointer; display: grid; place-items: center; transition: .15s;
  }
  .thread :global(.opt-add button:hover) { border-color: var(--accent); color: var(--accent) }
  .thread :global(.opt-name) { font-size: 13px; font-weight: 500; color: var(--text); display: flex; align-items: baseline; gap: 7px; text-transform: capitalize }
  .thread :global(.opt-kind) { font-size: 9px; color: var(--muted2); text-transform: uppercase; letter-spacing: .05em }
  .thread :global(.choice-foot) { display: flex; align-items: center; justify-content: space-between; gap: 12px; border-top: 1px solid var(--line); padding-top: 12px }
  .thread :global(.choice-hint) { font-size: 11px; color: var(--muted2); line-height: 1.45; max-width: 320px }
  .thread :global(.choice-meta) { font-size: 11px; color: var(--muted); font-family: 'JetBrains Mono', monospace }
</style>
