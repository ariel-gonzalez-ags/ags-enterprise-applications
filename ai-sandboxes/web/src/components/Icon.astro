---
// Central icon registry (24×24 stroke icons, currentColor). Content files
// reference icons by name — add new icons here, never inline in pages.
interface Props {
  name: keyof typeof paths;
  size?: number;
}
const { name, size = 24 } = Astro.props;

const paths = {
