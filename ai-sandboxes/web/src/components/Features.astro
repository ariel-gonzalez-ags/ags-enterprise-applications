---
import Icon from './Icon.astro';
import SectionHead from './SectionHead.astro';
import { features } from '../content/home.js';
---
<section id="features" style="padding-top:0">
  <div class="wrap">
    <SectionHead eyebrow={features.eyebrow} title={features.title} />
    <div class="features">
      {features.items.map((f) => (
        <div class="feat">
          <div class="feat-icon"><Icon name={f.icon} size={18} /></div>
          <h3>{f.title}</h3>
          <p>{f.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .features { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px }
  .feat { background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius); padding: 26px }
  .feat-icon { width: 38px; height: 38px; border-radius: 9px; background: var(--accent-dim); display: grid; place-items: center; margin-bottom: 16px; color: var(--accent) }
  .feat h3 { font-size: 15.5px; font-weight: 600; margin-bottom: 7px }
  .feat p { font-size: 13.5px; color: var(--muted); line-height: 1.55 }
  @media (max-width: 900px) { .features { grid-template-columns: 1fr } }
</style>
