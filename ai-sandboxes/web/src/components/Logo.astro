---
// The Agisphire mark (C4g-6 twin-arc ring + A1 counter A), as an inline SVG so
// it inherits layout and works without a request. Light variant swaps the A to
// dark ink; the ring stays ember on any background.
interface Props {
  size?: number;
  light?: boolean;   // render for light backgrounds (A in --bg ink)
  class?: string;
}
const { size = 48, light = false, class: cls = '' } = Astro.props;
const aFill = light ? '#060504' : '#F2EDE8';
---
<svg
  viewBox="0 0 100 100"
  width={size}
  height={size}
  class={cls}
  role="img"
  aria-label="Agisphire"
>
  <path d="M14 50 A36 36 0 0 1 86 50" fill="none" stroke="#F05623" stroke-width="6" stroke-linecap="round" />
  <path d="M14 50 A36 36 0 0 0 86 50" fill="none" stroke="#F05623" stroke-width="6" stroke-linecap="round" opacity=".45" />
  <path fill={aFill} fill-rule="evenodd" d="M50 29 L67 70 L55.5 70 L53 61.5 L47 61.5 L44.5 70 L33 70 Z M50 43 L53.8 54 L46.2 54 Z" />
</svg>
