---
// Left rail: task library. Shell only — console.js renders cards from
// GET /api/tasks. "New task" starts a brainstorm.
import Icon from './Icon.astro';
---
<div class="rail-in">
  <div class="rail-head">
    <span class="rail-title"><Icon name="library" size={15} /> Tasks</span>
    <button class="new-btn" data-console="new-task"><Icon name="plus" size={14} /> New task</button>
  </div>

  <div class="task-list" data-console="task-list">
    <p class="empty mono">loading…</p>
  </div>
</div>

<style>
  .rail-in { padding: 20px 16px; display: flex; flex-direction: column; gap: 16px }
  .rail-head { display: flex; justify-content: space-between; align-items: center }
  .rail-title { font-size: 13px; font-weight: 600; color: var(--muted); display: flex; gap: 8px; align-items: center; text-transform: uppercase; letter-spacing: .06em }
  .new-btn {
    display: inline-flex; align-items: center; gap: 6px; font-size: 12.5px; font-weight: 500;
    background: transparent; color: var(--muted); padding: 6px 11px; border-radius: 9px;
    border: 1px solid var(--line2); transition: .2s; cursor: pointer;
  }
  .new-btn:hover { color: var(--text); border-color: #57301A }

  .task-list { display: flex; flex-direction: column; gap: 4px }
  /* Task cards render at runtime via console.js — Astro scoping doesn't
     reach them, so these selectors are global (prefixed by .task-list). */
  .task-list :global(.empty) { font-size: 11.5px; color: var(--muted2); padding: 12px 14px }
  .task-list :global(.task) {
    display: block; background: transparent; border: 1px solid transparent;
    border-radius: 12px; padding: 12px 14px; transition: .15s; cursor: pointer;
    text-align: left; width: 100%; color: var(--text); font: inherit;
  }
  .task-list :global(.task:hover) { background: var(--panel2) }
  .task-list :global(.task.active) { background: var(--panel2); border-color: var(--line) }
  .task-list :global(.t-top) { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px }
  .task-list :global(.t-prov) { height: 13px; width: auto; max-width: 22px; border-radius: 3px; display: block; opacity: .9 }
  .task-list :global(.t-title) { font-size: 13.5px; font-weight: 500; line-height: 1.4; margin-bottom: 8px }
  .task-list :global(.t-meta) { font-size: 11px; color: var(--muted2); margin-bottom: 10px }
  .task-list :global(.t-checks) { display: flex; align-items: center; gap: 8px; font-size: 11px; color: var(--muted) }
  .task-list :global(.bar) { flex: 1; height: 3px; border-radius: 99px; background: var(--line); overflow: hidden }
  .task-list :global(.fill) { display: block; height: 100%; background: var(--muted); border-radius: 99px }

  .task-list :global(.state) { font-size: 10px; font-weight: 500; font-family: 'JetBrains Mono', monospace; padding: 3px 8px; border-radius: 6px; letter-spacing: .04em; color: var(--muted); border: 1px solid var(--line2) }
  .task-list :global(.s-drafting) { color: var(--muted2) }
  .task-list :global(.s-planned) { color: var(--muted) }
  .task-list :global(.s-running) { color: var(--accent); border-color: rgba(240, 86, 35, .35) }
  .task-list :global(.s-verified) { color: var(--muted) }
  .task-list :global(.s-delivered) { color: var(--muted2) }
</style>
