---
// Left rail: task library. Each card shows state pill, provider glyph,
// formats, and check progress. "New task" starts a brainstorm.
import Icon from './Icon.astro';
import ProviderIcon from './ProviderIcon.astro';
import { tasks, taskStates } from '../content/console.js';

const stateMeta = Object.fromEntries(taskStates.map((s) => [s.id, s]));
---
<div class="rail-in">
  <div class="rail-head">
    <span class="rail-title"><Icon name="library" size={15} /> Tasks</span>
    <a href="/app/new" class="new-btn"><Icon name="plus" size={14} /> New task</a>
  </div>

  <div class="task-list">
    {tasks.map((t) => (
      <a href={`/app/tasks/${t.id}`} class={`task ${t.state === 'running' ? 'active' : ''}`}>
        <div class="t-top">
          <span class={`state s-${t.state}`}>{stateMeta[t.state].label}</span>
          <ProviderIcon id={t.provider} size={15} />
        </div>
        <div class="t-title">{t.title}</div>
        <div class="t-meta mono">
          <span>{t.id}</span> · <span>{t.updated}</span>
        </div>
        <div class="t-checks">
          <span class="bar"><span class="fill" style={`width:${(t.checks.passed / t.checks.total) * 100}%`}></span></span>
          <span class="mono">{t.checks.passed}/{t.checks.total}</span>
        </div>
      </a>
    ))}
  </div>
</div>

<style>
  .rail-in { padding: 20px 16px; display: flex; flex-direction: column; gap: 16px }
  .rail-head { display: flex; justify-content: space-between; align-items: center }
  .rail-title { font-size: 13px; font-weight: 600; color: var(--muted); display: flex; gap: 8px; align-items: center; text-transform: uppercase; letter-spacing: .06em }
  .new-btn {
    display: inline-flex; align-items: center; gap: 6px; font-size: 12.5px; font-weight: 600;
    background: var(--accent); color: #160802; padding: 7px 12px; border-radius: 9px;
  }
  .new-btn:hover { background: #FF6B38 }

  .task-list { display: flex; flex-direction: column; gap: 10px }
  .task {
    display: block; background: var(--panel2); border: 1px solid var(--line2);
    border-radius: 12px; padding: 14px; transition: .2s;
  }
  .task:hover { border-color: #57301A; transform: translateY(-1px) }
  .task.active { border-color: var(--accent) }
  .t-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px }
  .t-title { font-size: 13.5px; font-weight: 500; line-height: 1.4; margin-bottom: 8px }
  .t-meta { font-size: 11px; color: var(--muted2); margin-bottom: 10px }
  .t-checks { display: flex; align-items: center; gap: 8px; font-size: 11px; color: var(--muted) }
  .bar { flex: 1; height: 4px; border-radius: 99px; background: var(--line); overflow: hidden }
  .fill { display: block; height: 100%; background: var(--accent); border-radius: 99px }

  .state { font-size: 10.5px; font-weight: 600; font-family: 'JetBrains Mono', monospace; padding: 3px 8px; border-radius: 6px; text-transform: uppercase; letter-spacing: .04em }
  .s-drafting { background: var(--line); color: var(--muted) }
  .s-planned { background: rgba(255, 177, 132, .12); color: var(--warn) }
  .s-running { background: var(--accent-dim); color: var(--accent) }
  .s-verified { background: var(--accent-dim); color: var(--accent) }
  .s-delivered { background: rgba(52, 168, 83, .12); color: #5BD97E }
</style>
