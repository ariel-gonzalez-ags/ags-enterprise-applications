---
// /login: the sign-in screen. Brand mark, one line, one button. Nothing else.
// Anonymous-only: signed-in users get bounced to /app by the script below.
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import Icon from '../components/Icon.astro';
import { login, brand } from '../content/home.js';
---
<Base title="Agisphire: Sign in" auth>
  <main class="login">
    <div class="grid-bg" aria-hidden="true"></div>
    <div class="glow glow-a" aria-hidden="true"></div>
    <div class="glow glow-b" aria-hidden="true"></div>
    <div class="arc arc-a" aria-hidden="true"></div>
    <div class="arc arc-b" aria-hidden="true"></div>

    <div class="login-card">
      <a class="login-brand" href="/" aria-label={brand.name}>
        <Logo size={48} />
      </a>
      <h1>{login.title}</h1>
      <a href="/api/auth/login?next=/app" class="btn primary lg login-cta">
        <span class="g-chip"><Icon name="google" size={16} /></span>
        {login.button}
      </a>
    </div>
  </main>

  <script>
    // Signed-in users have no business here: send them to the console.
    fetch('/api/auth/me', { credentials: 'same-origin' })
      .then(function (r) { return r.ok ? r.json() : null; })
      .then(function (data) {
        if (data && data.user) window.location.replace('/app');
      })
      .catch(function () { /* stay: show the login card */ });
  </script>
</Base>

<style>
  .login {
    position: relative; min-height: 100vh; display: grid; place-items: center;
    padding: 40px 24px; overflow: hidden; background: var(--bg);
  }

  /* Faint blueprint grid, masked so it fades toward the edges */
  .grid-bg {
    position: absolute; inset: 0;
    background-image:
      linear-gradient(var(--line) 1px, transparent 1px),
      linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 44px 44px;
    opacity: .35;
    -webkit-mask-image: radial-gradient(760px 620px at 50% 42%, #000 30%, transparent 75%);
    mask-image: radial-gradient(760px 620px at 50% 42%, #000 30%, transparent 75%);
  }

  /* Warm ember glow + a cool counterweight for depth */
  .glow { position: absolute; border-radius: 50%; pointer-events: none; filter: blur(90px) }
  .glow-a {
    width: 620px; height: 620px; left: 50%; top: -20%;
    transform: translateX(-56%); background: var(--accent); opacity: .16;
  }
  .glow-b {
    width: 520px; height: 520px; right: -10%; bottom: -24%;
    background: var(--deep-red); opacity: .13;
  }

  /* Twin oversized arcs: the brand ring as quiet geometry */
  .arc { position: absolute; border-radius: 50%; pointer-events: none; border: 1px solid transparent }
  .arc-a {
    width: 900px; height: 900px; left: 50%; top: 50%;
    transform: translate(-50%, -54%);
    border-top-color: rgba(240, 86, 35, .16);
  }
  .arc-b {
    width: 1180px; height: 1180px; left: 50%; top: 50%;
    transform: translate(-50%, -46%);
    border-bottom-color: var(--line2); opacity: .7;
  }

  .login-card {
    position: relative; text-align: center; padding: 56px 48px; max-width: 380px; width: 100%;
    background: color-mix(in srgb, var(--panel) 82%, transparent);
    backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
    border: 1px solid var(--line); border-radius: var(--radius);
    box-shadow: 0 24px 80px rgba(0, 0, 0, .5);
  }
  .login-brand { display: flex; justify-content: center; margin-bottom: 22px; color: var(--text) }
  .login-card h1 { font-size: 22px; font-weight: 600; letter-spacing: -.02em; margin-bottom: 28px }
  .login-cta { width: 100%; justify-content: center; gap: 10px }

  /* The Google G needs a light chip to read on the ember gradient */
  .g-chip {
    display: grid; place-items: center; width: 24px; height: 24px;
    background: #FFFFFF; border-radius: 6px; flex-shrink: 0;
  }

  @media (max-width: 560px) {
    .login-card { padding: 44px 28px }
  }
</style>
