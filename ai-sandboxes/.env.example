# Copy to .env.local and fill in. .env.local is gitignored: never commit it.
#
# Google OAuth client (Web application):
#   https://console.cloud.google.com/apis/credentials
#   Authorized redirect URI: http://localhost:8090/api/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Signs session cookies. Generate: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
SESSION_SECRET=

# Public origin of the site (must match the Google redirect URI origin).
BASE_URL=http://localhost:8090

# Set to 1 behind HTTPS in production.
COOKIE_SECURE=0

# Planner LLM: Gemini via Google AI Studio key:
#   https://aistudio.google.com/apikey
# Without a key, chat endpoints return 503 (planner_configured: false).
# Roadmap: replace key auth with Vertex AI + Workload Identity Federation.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Real sandbox execution (stage 1). Off by default: runs stay simulated.
#   EXECUTOR_ENABLED=1  -> run deliverables in a real container and verify by
#                          idempotency re-run instead of the simulated timer.
#   EXECUTOR_BACKEND=local -> run on the host Docker daemon (no cloud).
#   "azure" (stage 2) runs the same payload on Azure Container Instances.
# Local backend requires the api container to reach the Docker daemon.
EXECUTOR_ENABLED=0
EXECUTOR_BACKEND=local

# Azure platform account (stage 2: real sandboxes). The platform service
# principal creates/destroys one resource group per sandbox and is the only
# subscription-level credential; sandbox agents get a per-RG managed identity.
#   az ad sp create-for-rbac --name ags-sandbox-platform \
#     --role Contributor --scopes /subscriptions/<SUB_ID>
# Without these, EXECUTOR_BACKEND=azure runs degrade to a clear error.
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_LOCATION=eastus

# Embers: the customer-facing cost meter (1 Ember = $0.01). Every run burns
# Embers from sandbox-seconds + agent LLM tokens at a blended rate; the balance
# gates new runs at approve. Trial allowance is granted once per user. Top-up
# (Stripe) is Phase 2.
EMBER_PEG_USD=0.01
EMBER_PER_SANDBOX_MIN=3
EMBER_PER_1K_TOKENS=2
EMBER_TRIAL_ALLOWANCE=300
EMBER_GRACE_SECONDS=60

# Stripe (Phase 2b): Ember top-up + card-gated trial. Server-side SECRET key only
# (test mode: sk_test_...); the browser is redirected to Stripe-hosted Checkout,
# so card data never touches our servers. Create a restricted key at
# Dashboard -> Developers -> API keys. The webhook secret (whsec_...) verifies
# that inbound "payment succeeded" events really come from Stripe; for local dev
# it comes from `stripe listen --forward-to localhost:8090/api/stripe/webhook`.
#   EMBER_MIN_TOPUP_USD: smallest credit purchase ($10 floor; Stripe's flat fee
#   makes smaller charges wasteful). 1 Ember = $0.01, so $10 = 1000 Embers.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
EMBER_MIN_TOPUP_USD=10

# Rate limits (Phase 2, TODO #6): cap a single user's blast radius. 0 disables a
# limit. RATELIMIT_MAX_CONCURRENT = running sandboxes at once per user;
# RATELIMIT_MAX_SANDBOX_HOURS_DAY = sandbox compute hours per user per UTC day.
RATELIMIT_MAX_CONCURRENT=2
RATELIMIT_MAX_SANDBOX_HOURS_DAY=8
